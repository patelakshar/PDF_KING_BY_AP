{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=pdfsolver.db"
  },
  "Ocr": {
    "TessDataPath": "tessdata",
    "Language": "eng",
    "AdditionalLanguages": [],
    "Dpi": 300,
    "FallbackDpi": 400,
    "MinSelectableCharsPerPage": 15,
    "EnablePreprocessing": true,
    "ConvertToGrayscale": true,
    "NormalizeContrast": true,
    "RemoveNoise": true,
    "Deskew": true,
    "AutoRotate": true,
    "UpscaleSmallText": true,
    "MinUpscaleWidth": 1600,
    "PageSegmentationModes": [ "Auto", "SingleBlock", "SparseText" ],
    "MinAcceptableConfidence": 0.45
  },
  "Storage": {
    "UploadFolder": "UploadedPdfs"
  }
}
