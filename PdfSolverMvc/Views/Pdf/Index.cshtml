@model PdfListViewModel
@{
    ViewData["Title"] = "2. List Information";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1">Uploaded PDFs &amp; Extracted Registry</h2>
        <p class="text-muted small mb-0">Inspect extracted grids, embedded images/logos, OCR diagnostics, and original documents.</p>
    </div>
    <a asp-action="Upload" class="btn btn-primary fw-semibold px-3">
        <i class="bi bi-plus-lg me-1"></i>Upload More PDFs
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card lt-kpi-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total PDFs</div>
                    <div class="fs-2 fw-bold text-dark">@Model.TotalFiles</div>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                    <i class="bi bi-file-earmark-pdf fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card lt-kpi-card p-3" style="border-left-color: #0ea5e9;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Pages</div>
                    <div class="fs-2 fw-bold text-dark">@Model.TotalPages</div>
                </div>
                <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                    <i class="bi bi-layers fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card lt-kpi-card p-3" style="border-left-color: #f59e0b;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">OCR Processed</div>
                    <div class="fs-2 fw-bold text-dark">@Model.OcrProcessedCount</div>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3">
                    <i class="bi bi-upc-scan fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<form method="get" asp-action="Index" class="card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control"
                       placeholder="Search by file name or extracted text..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="filterStatus" class="form-select">
                <option value="All" selected="@(Model.FilterStatus == "All")">All Methods / Status</option>
                <option value="DirectText" selected="@(Model.FilterStatus == "DirectText")">Direct Text</option>
                <option value="OcrFallback" selected="@(Model.FilterStatus == "OcrFallback")">OCR Fallback</option>
                <option value="HybridOcr" selected="@(Model.FilterStatus == "HybridOcr")">Hybrid OCR</option>
                <option value="PartialOcrNeeded" selected="@(Model.FilterStatus == "PartialOcrNeeded")">Needs OCR Data</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark flex-grow-1 fw-semibold">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-uppercase text-muted">
                    <th>File Name</th>
                    <th>Pages</th>
                    <th>Size</th>
                    <th>Extraction</th>
                    <th>Uploaded (UTC)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Documents.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No PDFs found. <a asp-action="Upload" class="fw-semibold">Upload your first PDF</a> to get started.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var doc in Model.Documents)
                    {
                        var sizeKb = Math.Round(doc.FileSizeBytes / 1024.0, 1);
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@doc.Id" class="fw-semibold text-decoration-none text-dark">
                                    <i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i>@doc.OriginalFileName
                                </a>
                            </td>
                            <td><span class="badge bg-light text-dark border">@doc.PageCount</span></td>
                            <td class="small text-muted">@(sizeKb >= 1024 ? $"{Math.Round(sizeKb / 1024.0, 2)} MB" : $"{sizeKb} KB")</td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">@doc.ExtractionMethod</span>
                                @if (doc.Status != "Processed")
                                {
                                    <span class="badge bg-warning text-dark">@doc.Status</span>
                                }
                            </td>
                            <td class="small text-muted">@doc.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@doc.Id" class="btn btn-sm btn-primary fw-semibold">
                                    <i class="bi bi-eye me-1"></i>View Content
                                </a>
                                <a asp-action="ViewFile" asp-route-id="@doc.Id" asp-route-download="true" class="btn btn-sm btn-outline-secondary" title="Download PDF">
                                    <i class="bi bi-download"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@doc.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this PDF and its extracted data?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
