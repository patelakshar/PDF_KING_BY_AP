@model PdfDetailsViewModel
@{
    ViewData["Title"] = $"3. PDF Content - {Model.Document.OriginalFileName}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">List Information</a></li>
                <li class="breadcrumb-item active">@Model.Document.OriginalFileName</li>
            </ol>
        </nav>
        <h2 class="h4 mb-0">
            <i class="bi bi-file-earmark-text text-primary me-2"></i>@Model.Document.OriginalFileName
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportText" asp-route-id="@Model.Document.Id" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-text me-1"></i>Download Aligned Text
        </a>
        <a asp-action="ViewFile" asp-route-id="@Model.Document.Id" asp-route-download="true" class="btn btn-outline-secondary">
            <i class="bi bi-download me-1"></i>Download PDF
        </a>
        <a asp-action="Upload" class="btn btn-primary">
            <i class="bi bi-cloud-arrow-up me-1"></i>Upload Another
        </a>
        <a asp-action="ExportCsv" asp-route-id="@Model.Document.Id" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Document.Notes))
{
    <div class="alert alert-info small">
        <i class="bi bi-info-circle me-1"></i><strong>Processing Notes:</strong> @Model.Document.Notes
    </div>
}

<ul class="nav nav-tabs mb-3" id="contentTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="grid-tab" data-bs-toggle="tab" data-bs-target="#grid-pane" type="button">
            <i class="bi bi-table me-1"></i>Structured Grid (@Model.Pages.Count Pages)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="raw-tab" data-bs-toggle="tab" data-bs-target="#raw-pane" type="button">
            <i class="bi bi-code-square me-1"></i>Extracted Text
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pdf-tab" data-bs-toggle="tab" data-bs-target="#pdf-pane" type="button">
            <i class="bi bi-file-pdf me-1"></i>Original PDF Viewer
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="grid-pane">
        @if (!Model.Pages.Any())
        {
            <div class="card p-4 text-muted">No structured rows were extracted.</div>
        }
        else
        {
            foreach (var p in Model.Pages)
            {
                <div class="card mb-4">
                    <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span class="fw-semibold">Page @p.PageNumber — Column-Aligned Grid</span>
                        <span class="small text-muted d-flex flex-wrap align-items-center gap-1">
                            <span class="badge bg-secondary">@p.ExtractionType</span>
                            @if (p.OcrConfidence.HasValue)
                            {
                                <span class="badge bg-info text-dark">Confidence: @($"{p.OcrConfidence.Value:P0}")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.SelectedPsm))
                            {
                                <span class="badge bg-light text-dark border">PSM: @p.SelectedPsm</span>
                            }
                            @if (p.RotationDegrees.HasValue && Math.Abs(p.RotationDegrees.Value) >= 0.5)
                            {
                                <span class="badge bg-light text-dark border">Rotated: @($"{p.RotationDegrees.Value:0.#}°")</span>
                            }
                            <span class="ms-1">@p.TableRows.Count rows &middot; @p.WordCount words</span>
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(p.ExtractionNotes))
                    {
                        <div class="px-3 py-1 bg-warning bg-opacity-10 border-bottom small text-muted">
                            <i class="bi bi-info-circle me-1"></i>@p.ExtractionNotes
                        </div>
                    }
                    <div class="table-responsive" style="max-height: 70vh;">
                        <table class="table table-sm table-bordered table-hover mb-0 small" style="font-size: 0.78rem; white-space: nowrap;">
                            <tbody>
                                @foreach (var row in p.TableRows)
                                {
                                    <tr>
                                        @foreach (var cell in row)
                                        {
                                            <td>@cell</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(p.RawOcrText))
                    {
                        <details class="border-top bg-light px-3 py-2 small">
                            <summary class="fw-semibold text-muted" style="cursor: pointer;">Raw OCR / Reading-Order Text</summary>
                            <pre class="mt-2 mb-0" style="white-space: pre-wrap; font-size: 0.8rem;">@p.RawOcrText</pre>
                        </details>
                    }
                </div>
            }
        }
    </div>

    <div class="tab-pane fade" id="raw-pane">
        <div class="card p-4">
            <pre class="mb-0" style="white-space: pre-wrap; font-size: 0.85rem;">@Model.Document.RawExtractedText</pre>
        </div>
    </div>

    <div class="tab-pane fade" id="pdf-pane">
        <div class="card overflow-hidden" style="height: 78vh;">
            <iframe src="@Url.Action("ViewFile", "Pdf", new { id = Model.Document.Id })"
                    width="100%" height="100%" style="border: none;"></iframe>
        </div>
    </div>
</div>
