@model PdfUploadViewModel
@{
    ViewData["Title"] = "1. PDF Upload";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <div class="d-flex align-items-center mb-3">
                <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 me-3">
                    <i class="bi bi-file-earmark-arrow-up fs-3"></i>
                </div>
                <div>
                    <h2 class="h4 mb-1">Upload Complex PDFs</h2>
                    <p class="text-muted mb-0 small">
                        Supports multi-column layouts, tables, large multi-page PDFs, scanned PDFs (OCR fallback), and AI-powered solving.
                    </p>
                </div>
            </div>

            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Files" class="form-label fw-semibold"></label>
                    <input asp-for="Files" type="file" accept=".pdf,application/pdf" multiple class="form-control form-control-lg" />
                    <div class="form-text">You can select one or multiple PDF files (up to 100 MB total).</div>
                    <span asp-validation-for="Files" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-list-ul me-1"></i>View Uploaded List
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg px-4" id="submitBtn">
                        <i class="bi bi-cpu me-2"></i>Upload &amp; Extract
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing PDFs...';
        });
    </script>
}
